              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Pedido aguardando pagamento e com canalPedido registrado\", function () { pm.expect(j.status).to.eql(\"AGUARDANDO_PAGAMENTO\"); pm.expect(j.canalPedido).to.eql(\"TOTEM\"); });",
                  "pm.test(\"Total = 2 x 12,50 + 1 x 15,00 = 40,00 e 2 itens\", function () { pm.expect(Number(j.total)).to.eql(40); pm.expect(j.itens.length).to.eql(2); });",
                  "pm.collectionVariables.set(\"pedidoId\", j.id);"
                ]
              }
            }
          ],
