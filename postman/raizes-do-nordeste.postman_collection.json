          "name": "T05 - Consultar cardápio da unidade 1 (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Lista os produtos da unidade com estoque\", function () { pm.expect(j.length).to.be.at.least(5); pm.expect(j[0]).to.have.property(\"nome\"); pm.expect(j[0]).to.have.property(\"quantidade\"); });"
                ]
              }
