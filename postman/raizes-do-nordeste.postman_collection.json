{
  "info": {
    "name": "Raizes do Nordeste - API basica (Back-end)",
    "description": "Execute as pastas NA ORDEM (01 a 05), com a API rodando em {{baseUrl}} e o banco recém-criado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "tokenGerente",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01-Auth",
      "item": [
        {
          "name": "T01 - Login válido (cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Retorna o accessToken\", function () { pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"Perfil CLIENTE\", function () { pm.expect(j.user.perfil).to.eql(\"CLIENTE\"); });",
                  "pm.test(\"Não expõe senha nem hash\", function () { pm.expect(JSON.stringify(j)).to.not.include(\"senha\"); });",
                  "pm.collectionVariables.set(\"tokenCliente\", j.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@raizes.com\",\n  \"senha\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Pré-condição: API rodando com o seed. Guarda o token em {{tokenCliente}}."
          }
        },
        {
          "name": "T02 - Login com senha inválida (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Código de erro CREDENCIAIS_INVALIDAS\", function () { pm.expect(pm.response.json().error).to.eql(\"CREDENCIAIS_INVALIDAS\"); });",
                  "pm.test(\"Erro no formato padrão (error, message, details, timestamp, path)\", function () {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.property(\"error\");",
                  "  pm.expect(j).to.have.property(\"message\");",
                  "  pm.expect(j).to.have.property(\"details\");",
                  "  pm.expect(j).to.have.property(\"timestamp\");",
                  "  pm.expect(j).to.have.property(\"path\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
