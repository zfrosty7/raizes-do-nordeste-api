# Copie este arquivo para .env e ajuste os valores se quiser.
# ATENÇÃO: o Spring Boot NÃO lê o arquivo .env sozinho. Exporte as variáveis no terminal
# (ou configure-as na sua IDE) antes de iniciar a API. Todas têm valor padrão, então são opcionais.
DB_URL=jdbc:h2:file:./data/raizes;DB_CLOSE_ON_EXIT=FALSE
DB_USER=sa
DB_PASSWORD=
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres
JWT_EXPIRATION_MINUTES=60
