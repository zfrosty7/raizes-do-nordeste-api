classDiagram
    class Usuario {
        Long id
        String nome
        String email
        String senhaHash
        Perfil perfil
        boolean consentimentoLgpd
    }
    class Unidade {
        Long id
        String nome
        String cidade
    }
    class Produto {
        Long id
        String nome
        BigDecimal preco
        int quantidade
        Long unidadeId
        baixarEstoque(int) void
        devolverEstoque(int) void
    }
    class Pedido {
        Long id
        Long clienteId
        Long unidadeId
        CanalPedido canalPedido
        StatusPedido status
        FormaPagamento formaPagamento
        BigDecimal total
        adicionarItem(ItemPedido) void
    }
    class ItemPedido {
        Long id
        Long produtoId
        int quantidade
        BigDecimal precoUnitario
    }
    class Pagamento {
        Long id
        Long pedidoId
        StatusPagamento status
        BigDecimal valor
        String referencia
    }
    class CanalPedido {
        <<enumeration>>
        APP
        TOTEM
        BALCAO
        PICKUP
        WEB
    }
    class StatusPedido {
        <<enumeration>>
        AGUARDANDO_PAGAMENTO
        PAGAMENTO_RECUSADO
        PAGO
        EM_PREPARO
        PRONTO
        ENTREGUE
        CANCELADO
    }
    class Perfil {
        <<enumeration>>
        CLIENTE
        GERENTE
    }
    Usuario "1" --> "0..*" Pedido : faz
    Unidade "1" --> "0..*" Pedido : recebe
    Unidade "1" --> "0..*" Produto : tem
    Pedido "1" *-- "1..*" ItemPedido : contem
    Produto "1" --> "0..*" ItemPedido : vendido em
    Pedido "1" --> "0..*" Pagamento : pago por
    Pedido --> CanalPedido
    Pedido --> StatusPedido
    Usuario --> Perfil
